#!/usr/bin/env python3
"""Команды для Markdown-пространства LifeOS."""

import argparse
import fcntl
import json
import os
import re
import stat
import sys
import tempfile
from collections import defaultdict
from datetime import date
from pathlib import Path
from urllib.parse import unquote


ROOT = Path(__file__).resolve().parent.parent
EXCLUDED = {".git", ".local", "private", "node_modules"}
DESTINATIONS = {
    "case": "cases/{slug}/README.md",
    "knowledge": "knowledge/{slug}.md",
    "decision": "decisions/{date}-{slug}.md",
    "post": "content/drafts/{slug}.md",
}
CASE_INDEX = "# Дела\n\n## Активные\n\n## Закрытые\n"
PLACEHOLDER = re.compile(r"\{\{([^{}\n]+)\}\}")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
INLINE_CODE = re.compile(r"(?<![\\`])(`+)(?!`)[\s\S]*?(?<!`)\1(?!`)")
LINK = re.compile(
    r'''(?<!\\)\[(?:\\.|[^\[\]\\]|\[[^\[\]]*\])*\]\(\s*
        (?:<([^<>\n]*)>|((?:\\.|[^()\s\\]|\((?:\\.|[^()\s\\])*\))*))
        (?:\s+(?:"[^"]*"|'[^']*'|\([^)]*\)))?\s*\)''',
    re.VERBOSE,
)


class LifeError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def __init__(self, **kwargs):
        super().__init__(add_help=False, **kwargs)
        self._positionals.title = "аргументы"
        self._optionals.title = "параметры"
        self.add_argument("-h", "--help", action="help", help="показать эту справку")

    def format_help(self):
        return super().format_help().replace("usage:", "Использование:", 1)

    def format_usage(self):
        return super().format_usage().replace("usage:", "Использование:", 1)

    def error(self, message):
        for original, translation in (
            ("the following arguments are required:", "укажите обязательные аргументы:"),
            ("unrecognized arguments:", "неизвестные аргументы:"),
            ("expected one argument", "требуется значение"),
            ("invalid choice:", "неизвестный вариант:"),
            (" (choose from ", " (доступны "),
            ("argument ", "аргумент "),
        ):
            message = message.replace(original, translation)
        self.print_usage(sys.stderr)
        self.exit(2, f"Ошибка: {message}\n")


def parse_date(value):
    if re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value):
        try:
            return date.fromisoformat(value)
        except ValueError:
            pass
    raise argparse.ArgumentTypeError("укажите существующую дату в формате YYYY-MM-DD")


def save_new(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    file = path.open("x", encoding="utf-8")
    try:
        with file:
            file.write(content)
    except (OSError, UnicodeError):
        path.unlink()
        raise


def from_template(root, kind, **values):
    template = root / "templates" / f"{kind}.md"
    if not template.is_file():
        raise LifeError(f"Шаблон не найден: templates/{kind}.md")
    return PLACEHOLDER.sub(
        lambda match: values.get(match[1], match[0]), template.read_text(encoding="utf-8")
    )


def journal(root, command, today, week):
    slug = today.isoformat() if command == "today" else week
    path = root / "journal" / slug[:4] / f"{slug}.md"
    status = "exists"
    if not path.is_file():
        kind = "day" if command == "today" else "week"
        title = slug if command == "today" else f"Неделя {week}"
        content = from_template(root, kind, title=title, date=today.isoformat(), week=week, slug=slug)
        try:
            save_new(path, content)
        except FileExistsError:
            if not path.is_file():
                raise
        else:
            status = "created"
    print(path.relative_to(root).as_posix(), status)


def register_case(root, slug, title, today):
    index = root / "cases" / "README.md"
    title = re.sub(r"([\\\[\]])", r"\\\1", " ".join(title.splitlines()))
    entry = f"- [{title}]({slug}/README.md) — открыто {today}.\n"
    # Запись в указатель из разных запусков CLI выполняется по очереди.
    directory = os.open(index.parent, os.O_RDONLY)
    try:
        fcntl.flock(directory, fcntl.LOCK_EX)
        exists = index.exists()
        content = CASE_INDEX
        if exists:
            with index.open(encoding="utf-8", newline="") as file:
                content = file.read()
        newline = "\r\n" if "\r\n" in content else "\n"
        lines = content.splitlines(keepends=True)
        position = next(
            (number + 1 for number, line in enumerate(lines) if line.strip() == "## Активные"),
            len(lines),
        )
        if position and not lines[position - 1].endswith("\n"):
            lines[position - 1] += newline
        lines.insert(position, entry.rstrip("\n") + newline)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=index.parent, delete=False) as file:
            temporary = Path(file.name)
            try:
                if exists:
                    os.fchmod(file.fileno(), stat.S_IMODE(index.stat().st_mode))
                file.writelines(lines)
                file.close()
                temporary.replace(index)
            finally:
                temporary.unlink(missing_ok=True)
    finally:
        os.close(directory)


def new(root, args, today, week):
    if not re.fullmatch(r"[a-z0-9-]+", args.slug):
        raise LifeError("SLUG может содержать только строчные латинские буквы, цифры и дефисы")
    relative = DESTINATIONS[args.kind].format(slug=args.slug, date=today)
    path = root / relative
    if path.exists() or path.is_symlink():
        raise LifeError(f"Файл уже существует: {relative}")
    content = from_template(root, args.kind, title=args.title, date=str(today), week=week, slug=args.slug)
    try:
        save_new(path, content)
    except FileExistsError:
        raise LifeError(f"Файл уже существует: {relative}") from None
    if args.kind == "case":
        try:
            register_case(root, args.slug, args.title, today)
        except (OSError, UnicodeError):
            path.unlink()
            raise
    print(relative)


def markdown_paths(folder, excluded=(), skip=None):
    for directory, names, files in os.walk(folder):
        current = Path(directory)
        names[:] = sorted(name for name in names if name not in excluded and current / name != skip)
        for name in sorted(files):
            if name.endswith(".md"):
                yield current / name


def markdown_links(content):
    start = 1
    block = []
    fence = None

    def links_in_block():
        prose = INLINE_CODE.sub(lambda match: re.sub(r"[^\n]", " ", match[0]), "\n".join(block))
        number = start
        previous = 0
        for match in LINK.finditer(prose):
            number += prose.count("\n", previous, match.start())
            previous = match.start()
            yield number, match[1] if match[1] is not None else match[2]

    for number, line in enumerate(content.splitlines(), 1):
        marker = FENCE.match(line)
        if fence:
            if marker and marker[1].startswith(fence) and not marker[2].strip():
                fence = None
                start = number + 1
        elif marker and (marker[1][0] == "~" or "`" not in marker[2]):
            yield from links_in_block()
            block.clear()
            fence = marker[1]
        elif not line.strip():
            yield from links_in_block()
            block.clear()
            start = number + 1
        else:
            block.append(line)
    if block:
        yield from links_in_block()


def relative_target(target):
    if target.startswith("/") or re.match(r"[a-zA-Z][a-zA-Z0-9+.\-]*:", target):
        return ""
    path = re.split(r"[?#]", target, maxsplit=1)[0]
    return unquote(re.sub(r"\\([^\w\s])", r"\1", path))


def check(root, as_json):
    errors = []
    warnings = []
    references = defaultdict(set)

    def report(items, path, line, message):
        items.append({"path": path.relative_to(root).as_posix(), "line": line, "message": message})

    paths = list(markdown_paths(root, EXCLUDED, skip=root / "templates"))
    for source in paths:
        try:
            content = source.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            report(errors, source, 1, "не удалось прочитать Markdown в UTF-8")
            continue
        for line, row in enumerate(content.splitlines(), 1):
            for match in PLACEHOLDER.finditer(row):
                report(errors, source, line, f"остался заполнитель {match[0]}")
        for line, link in markdown_links(content):
            target = relative_target(link)
            if target:
                destination = source.parent / target
                try:
                    exists = destination.exists()
                except (OSError, ValueError):
                    exists = False
                if exists:
                    references[destination.resolve()].add(source.resolve())
                else:
                    report(errors, source, line, f"битая ссылка на {link}")

    case_index = root / "cases" / "README.md"
    for path in paths:
        if path.name == "README.md" and path.parent.parent == case_index.parent:
            sources = references[path.resolve()] | references[path.parent.resolve()]
            if case_index.resolve() not in sources:
                report(errors, path, 1, "на дело нет ссылки из cases/README.md")
        if path.parent == root / "knowledge" and path.name != "README.md":
            if not references[path.resolve()] - {path.resolve()}:
                report(warnings, path, 1, "на заметку нет ссылок из других Markdown-файлов")

    if as_json:
        print(json.dumps({"ok": not errors, "errors": errors, "warnings": warnings}, ensure_ascii=False))
    else:
        for kind, items in (("ERROR", errors), ("WARN", warnings)):
            for item in items:
                print(f"{kind} {item['path']}:{item['line']} {item['message']}")
        print(f"Ошибок: {len(errors)}. Предупреждений: {len(warnings)}.")
    return int(bool(errors))


def search(root, query, scope):
    folder = (root / scope).resolve()
    if not folder.is_relative_to(root) or not folder.is_dir():
        raise LifeError("--scope должен указывать на папку внутри пространства")
    query = query.casefold()
    count = 0
    for path in markdown_paths(folder):
        for number, row in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            if query in row.casefold():
                count += 1
                if count <= 200:
                    print(f"{path.relative_to(root).as_posix()}:{number}: {row}")
    if count > 200:
        print(f"Остальные совпадения: {count - 200}.")


def main():
    parser = Parser(description="Записи и проверка Markdown-пространства LifeOS.")
    parser.add_argument("--root", type=Path, metavar="PATH", help="корень пространства")
    parser.add_argument("--date", type=parse_date, metavar="YYYY-MM-DD", help="подменить сегодняшнюю дату")
    commands = parser.add_subparsers(dest="command", metavar="КОМАНДА", required=True)
    for command, help_text in (
        ("today", "создать запись на день"), ("week", "создать запись на ISO-неделю"),
        ("new", "создать запись указанного вида"), ("check", "проверить целостность пространства"),
        ("search", "найти буквальные совпадения в Markdown"),
    ):
        commands.add_parser(command, description=help_text.capitalize() + ".", help=help_text)
    commands.choices["new"].add_argument("kind", choices=DESTINATIONS, metavar="KIND", help="case, knowledge, decision или post")
    commands.choices["new"].add_argument("slug", metavar="SLUG", help="идентификатор из a–z, 0–9 и дефисов")
    commands.choices["new"].add_argument("--title", required=True, help="заголовок записи")
    commands.choices["check"].add_argument("--json", action="store_true", help="вывести отчёт в JSON")
    commands.choices["search"].add_argument("query", metavar="QUERY", help="строка для поиска")
    commands.choices["search"].add_argument("--scope", type=Path, default=Path("."), metavar="DIR", help="папка для поиска")
    args = parser.parse_args()
    try:
        root = (args.root or ROOT).resolve()
        if not root.is_dir():
            raise LifeError(f"Папка пространства не найдена: {root}")
        today = args.date or date.today()
        iso = today.isocalendar()
        week = f"{iso.year:04d}-W{iso.week:02d}"
        if args.command in {"today", "week"}:
            journal(root, args.command, today, week)
        elif args.command == "new":
            new(root, args, today, week)
        elif args.command == "check":
            return check(root, args.json)
        else:
            search(root, args.query, args.scope)
    except (LifeError, OSError, UnicodeError) as error:
        print(f"Ошибка: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
